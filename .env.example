# Copy to .env, then replace local placeholders. Never commit .env.
NODE_ENV=development
# Bind only to loopback for local use. Set a private service-interface address in deployment.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Required for browser sessions; generate a fresh 32-byte hex value with Node on any platform:
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=replace-with-a-random-32-byte-hex-value
# Required before saving Ring OAuth tokens; 64 hex chars (32 bytes).
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
DATABASE_PATH=./data/doorway-relay.sqlite

# Local demo login used by `npm run seed:demo`; change it before use.
DEMO_EMAIL=demo@doorway.local
DEMO_PASSWORD=replace-with-a-local-demo-password

# Generate a random local test key; never register it with Ring or enable it in production.
RING_SIMULATOR_HMAC_KEY=replace-with-random-local-simulator-key
# Optional Playground access token; keep it server-side and replace when expired.
RING_ACCESS_TOKEN=
# Fill these only from your Ring Developer Portal; keep them server-side in .env.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Ring-issued HMAC signing key; verifies webhook signatures and the documented account-link nonce.
RING_HMAC_SIGNING_KEY=
# Set explicitly whenever configuring Ring credentials, an access token, or event history.
# Choose ring_live or ring_playground only after verifying the actual source; never label a
# Playground token/event as ring_live. Leave unset while Ring is not configured.
# RING_EVENT_SOURCE=ring_playground
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_BASE_URL=https://oauth.ring.com
# Outbound OAuth code-exchange/refresh forms are documented in the current Ring API reference.
# This flag does not verify Ring's separate inbound Token Exchange callback body.
# Leave blank to derive `${RING_OAUTH_BASE_URL}/oauth/token`; the example shows the resolved default.
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_OAUTH_CONTRACT_VERIFIED=true
# Ring documents a POST to the partner Token Exchange URL carrying an authorization code, but not
# its exact body/content type or acknowledgement response. Keep the route disabled until confirmed.
RING_TOKEN_EXCHANGE_ROUTE_ENABLED=false
# The one-way account-link route reads the account ID from the stored unclaimed-token record,
# validates the Ring time/nonce, masks the signed-in partner email, then sends the documented POST/PATCH.
# Optional: omit to run the devices-only probe. Set only after selecting a listed Playground device;
# the ID is not inferred or saved in the structure-only report.
RING_HISTORY_DEVICE_ID=
# Optional local-terminal display only; IDs are never written to reports/files. Do not paste this output.
RING_PROBE_PRINT_DEVICE_IDS=false
# Background history polling is opt-in for ring_live only. Playground polling stays disabled pending schema review.
RING_HISTORY_POLLING_ENABLED=false
RING_POLL_INTERVAL_SECONDS=60
STALL_THRESHOLD_HOURS=24
